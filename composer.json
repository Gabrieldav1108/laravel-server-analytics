{
    "name": "gabrieldav1108/laravel-server-analytics",
    "description": "Server-side usage analytics for Laravel: records page views, logins and business actions and ships them in batches to your own analytics endpoint.",
    "keywords": ["laravel", "analytics", "usage", "page-views", "audit", "server-side"],
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriel Davila"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/redis": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gabrieldav1108\\ServerAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabrieldav1108\\ServerAnalytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gabrieldav1108\\ServerAnalytics\\ServerAnalyticsServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
